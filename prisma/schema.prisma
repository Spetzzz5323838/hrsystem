generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgNodeType {
  COMPANY
  DIVISION
  OBJECT
  DEPARTMENT
}

enum Role {
  EMPLOYEE
  CURATOR
  STORE_ADMIN
  ONEC_ADMIN
  ACCOUNTANT
  AUDITOR
  COO
  SYSADMIN
}

enum ScopeType {
  SELF
  SUBORDINATES
  OWN_DEPARTMENT
  OWN_OBJECT
  OWN_SUBTREE
  CUSTOM_NODE
  COMPANY
}

enum Capability {
  VIEW_EMPLOYEE
  EDIT_PROFILE
  ACTIVATE_EMPLOYEE
  ASSIGN_CURATOR
  VIEW_DOCUMENTS
  UPLOAD_DOCUMENTS
  SET_1C_PASSWORD
  CLOSE_INTERNSHIP
  RUN_ATTESTATION
  RATE_POSITIVE_NEGATIVE
  ISSUE_REPRIMAND_AWARD
  ASSIGN_EQUIPMENT
  CLEAR_EQUIPMENT
  INIT_TERMINATION
  APPROVE_TERMINATION
  CLOSE_TERMINATION
  PRINT_CLEARANCE
  MANAGE_MATERIALS
  MANAGE_TEMPLATES
  MANAGE_ORG_STRUCTURE
  VIEW_ANALYTICS
  VIEW_AUDIT_LOG
  MANAGE_REMINDERS
  /// Немає в docs catalogs-v1.1.md §4.2 (той документ — до появи переведення й
  /// заморозки). Назви взято з prototype/hr-prototype-v3.jsx (ACTORS.caps),
  /// де прототип уже зіткнувся з тим самим пробілом і сам їх назвав.
  FREEZE
  INIT_TRANSFER
  APPROVE_TRANSFER
  /// Екран "Права доступу" (catalogs-v1.1.md §4.5) не називає власну
  /// можливість для себе — назва взята з prototype ACTORS.caps ("PERMISSIONS"),
  /// той самий пробіл докс, що й вище.
  MANAGE_PERMISSIONS
  /// Відпустки (v1.2 §4) — те саме, що вище: докс не називає можливість,
  /// беру APPROVE_VACATION з прототипу (ACTORS.caps).
  APPROVE_VACATION
  /// Друк бейджа-перепустки (catalogs-v1.1.md §6.1, п.10 "Видача бейджа,
  /// спецодягу, ключів" — докс не називає окрему можливість, MARK-пункт
  /// сам по собі без друку). Хто має PRINT_BADGE, тому дозволено читати
  /// САМЕ Document(type=PHOTO) для конкретної людини в обхід VIEW_DOCUMENTS
  /// (архітектурне рішення №9) — вузький виняток, узгоджений з
  /// користувачем 2026-09-17: фото для бейджа завантажує сам адміністратор
  /// магазину, і саме він же друкує бейдж, тому логічно, що воно йому
  /// доступне; інші типи сканів (паспорт, медкнижка тощо) лишаються
  /// недоступними, як і раніше.
  PRINT_BADGE
  /// Ручний скид пароля кабінету адміністратором (правки 20.09.2026, п.1) —
  /// поруч із самообслуговуванням через бот (lib/auth.ts::resetCabinetPassword,
  /// той самий код, різні виклики). Докс власної можливості не називають.
  RESET_CABINET_PASSWORD
  /// Примусове завершення пункту чек-листа сисадміном (правки 20.09.2026,
  /// п.9) — щоб процес не зависав, якщо призначений виконавець фізично
  /// недоступний (напр. втратив доступ до свого Telegram).
  FORCE_COMPLETE_TASK
  /// Керування вакансіями (з розмови 2026-09-23, поза докс) — створення й
  /// закриття задач "закрити вакансію".
  MANAGE_VACANCIES
  /// Оголошення й опитування (з розмови 2026-09-24, поза докс) — область
  /// дії визначає, на який вузол дерева можна надіслати.
  MANAGE_ANNOUNCEMENTS
  /// Термінал обліку робочого часу (2026-10-18): відкривати /terminal і
  /// реєструвати прибуття/завершення зміни — старший касир, адміністратор.
  OPERATE_TERMINAL
  /// Реєстрація/відкликання комп'ютерів-терміналів — сисадмін, COO, директор кластера.
  MANAGE_TERMINALS
  /// Табель робочого часу (етап 3): перегляд — адмін, директор кластера, бухгалтерія, COO.
  VIEW_TIMESHEET
  /// Ручне виправлення/додавання змін у табелі — з обов'язковою причиною й журналом.
  EDIT_SHIFTS
  /// Довідник типів ділянок (етап 5) — сисадмін і COO.
  MANAGE_AREA_TYPES
  /// Ділянки конкретного магазину, відповідальні, час відкриття — адмін свого магазину, директор кластера, COO.
  MANAGE_AREAS
  /// Регламент обходів (спільний на мережу, з версіями) — сисадмін і COO.
  MANAGE_REGULATION
  /// Розклад обходів конкретних магазинів — сисадмін, COO, директор кластера (свої магазини).
  MANAGE_INSPECTION_SCHEDULE
  /// Проводити обходи магазину (етап 7) — адмін свого магазину, директор кластера, COO.
  CONDUCT_INSPECTION
}

enum EmploymentStatus {
  REGISTERED
  ACTIVATED
  DOCUMENTS_PENDING
  TRAINEE
  READY_FOR_ATTESTATION
  ACTIVE
  TRANSFER_PENDING
  FROZEN
  TERMINATION_STARTED
  TERMINATED
}

enum CompetencySource {
  ATTESTATION
  TEST
  EXTERNAL_COURSE
  MANUAL
}

enum MaterialType {
  PDF
  VIDEO
  LINK
}

enum ProcessType {
  ONBOARDING
  OFFBOARDING
  EXTRA_TRAINING
  TRANSFER
}

enum ActionType {
  MARK
  UPLOAD
  INPUT_VALUE
  TEST
  APPROVAL
  AUTO
  /// Немає в plan-v1.md §6 (5 значень) — з'являється тільки в
  /// catalogs-v1.1.md §8.1 для пункту «Друк листа узгодження».
  PRINT
}

enum ProcessState {
  RUNNING
  DONE
  CANCELLED
}

/// PENDING/DONE — фактичні стани, що зберігаються. BLOCKED і OVERDUE —
/// похідні: рахуються при читанні (наступний блокуючий пункт заблокований,
/// поки не закрито попередній; протерміновано, якщо dueAt минув).
enum TaskStatus {
  PENDING
  DONE
}

/// Модуль-надбудова онбордингу (docs/hr-system-catalogs-v1.1.md §6.2).
/// null у ChecklistItemTemplate.module = базовий пункт для всіх.
enum ChecklistModule {
  CASHIER
  MVO
  FOOD
  RETAIL
  WAREHOUSE
  TRANSPORT
  SECURITY
  MANAGEMENT
  OFFICE
}

enum RatingType {
  POSITIVE
  NEGATIVE
  REPRIMAND
  AWARD
  AUTO
}

enum RatingSide {
  POS
  NEG
}

/// Три шари видимості (docs hr-rating-visibility-v1.3.md §1):
/// PRIVATE — тільки автор і керівники, які бачать цього працівника;
/// EMPLOYEE — і сам працівник; PUBLIC — і колеги.
enum Visibility {
  PRIVATE
  EMPLOYEE
  PUBLIC
}

/// Шість фіксованих критеріїв квартальної оцінки (docs v1.3 §4).
enum ReviewCriterion {
  QUALITY
  RELIABILITY
  PACE
  TEAM
  CLIENT
  INITIATIVE
}

/// Дерево організації: компанія -> напрям/кластер -> об'єкт -> відділ.
/// path — матеріалізований шлях виду "1.3.14", перевірка доступу зводиться
/// до target.path.startsWith(scope.path).
model OrgNode {
  id       Int         @id @default(autoincrement())
  type     OrgNodeType
  name     String
  code     String?     @unique
  parentId Int?
  parent   OrgNode?    @relation("OrgNodeTree", fields: [parentId], references: [id])
  children OrgNode[]   @relation("OrgNodeTree")
  path     String

  headEmploymentId Int?
  headEmployment   Employment? @relation(fields: [headEmploymentId], references: [id])

  address     String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  externalRef String?

  staffUnits                StaffUnit[]
  positionAccessAssignments PositionAccessAssignment[]
  roleAssignments           RoleAssignment[]
  equipment                 Equipment[]
  pendingHires              PendingHire[]
  terminals                 Terminal[]
  workShifts                WorkShift[]
  areas                     Area[]
  inspectionSchedule        InspectionSchedule?
  inspections               Inspection[]

  /// Час відкриття магазину "ГГ:ХХ" (етап 5) — від нього через 30 хв перевіряється, чи є персонал на ділянках. Порожньо — перевірки немає.
  openTime          String?
  /// Дата, коли перевірку "ділянка без персоналу" вже зроблено (раз на добу).
  staffingCheckedOn DateTime?      @db.Date
  announcements     Announcement[]
  polls             Poll[]

  @@index([path])
}

/// Заявка на найм по QR — реєстрація через Telegram-бот, ще без посади.
/// QR кодує об'єкт (`orgNodeId`), не штатну одиницю: адмін бачить факт
/// реєстрації й сам призначає посаду й відділ (docs catalogs-v1.1 §6.1,
/// п.3) — обираючи StaffUnit, що вже поєднує обидва. Розміщення
/// (`POST /api/pending-hires/[id]/place`) створює Person + Employment і
/// видаляє цей запис; поля тут навмисно дублюють Person, бо до розміщення
/// Person ще не існує.
model PendingHire {
  id         Int      @id @default(autoincrement())
  fullName   String
  birthDate  DateTime
  phone      String
  email      String?
  telegramId BigInt   @unique
  orgNodeId  Int
  orgNode    OrgNode  @relation(fields: [orgNodeId], references: [id])
  createdAt  DateTime @default(now())

  @@index([orgNodeId])
}

/// Фізична особа — окремо від факту роботи (Employment), щоб одна людина
/// могла мати кілька періодів роботи чи суміщень без переробки моделі.
/// Телефон — природний ключ для входу й пошуку, але не первинний ключ:
/// номери змінюються й повторно продаються операторами (docs v1.2 §5).
model Person {
  id                Int       @id @default(autoincrement())
  fullName          String
  birthDate         DateTime?
  telegramId        BigInt?   @unique
  phone             String    @unique
  email             String?
  phoneVerifiedAt   DateTime?
  passwordHash      String?
  externalRef       String?
  /// Код працівника для бейджа й обліку робочого часу (2026-10-18) — не
  /// секрет, випадкові цифри (не послідовні), генерує lib/badgeCode.ts.
  /// Перевидача (загублений бейдж) робить старий код недійсним.
  badgeCode         String?   @unique
  badgeCodeIssuedAt DateTime?
  createdAt         DateTime  @default(now())

  employments       Employment[]
  competencyRecords CompetencyRecord[]
  phoneHistory      PhoneHistory[]
  sessions          Session[]
  ratingEvents      RatingEvent[]
  badgeAwards       BadgeAward[]
  documents         Document[]
  loginChallenges   LoginChallenge[]
  trustedDevices    TrustedDevice[]
  notifications     Notification[]
  pollVotes         PollVote[]
}

/// Веб-сесія після входу. У базі — тільки хеш токена (SHA-256), сам
/// токен живе лише в httpOnly cookie й ніколи не потрапляє в БД у
/// відкритому вигляді. TTL 12 год (docs hr-system-plan-v1.md §4.4).
model Session {
  id        Int      @id @default(autoincrement())
  personId  Int
  person    Person   @relation(fields: [personId], references: [id])
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([personId])
}

enum LoginChallengeStatus {
  PENDING
  APPROVED
  EXPIRED
}

/// 2FA (docs plan-v1.md §4.4): підтвердження входу кнопкою в Telegram для
/// ONEC_ADMIN/ACCOUNTANT/COO/SYSADMIN. `consumedAt` — захист від подвійного
/// створення сесії, якщо клієнт опитує статус кілька разів поспіль.
model LoginChallenge {
  id         Int                  @id @default(autoincrement())
  personId   Int
  person     Person               @relation(fields: [personId], references: [id])
  status     LoginChallengeStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  expiresAt  DateTime
  approvedAt DateTime?
  consumedAt DateTime?

  @@index([personId])
}

/// "Довірений пристрій" (docs plan-v1.md §4.4, 30 днів) — окремий cookie
/// від сесії: після одного підтвердження 2FA цей браузер не питає його
/// знову, доки токен не спливе.
model TrustedDevice {
  id        Int      @id @default(autoincrement())
  personId  Int
  person    Person   @relation(fields: [personId], references: [id])
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([personId])
}

/// Історія зміни номера телефону — щоб пошук і зв'язки не ламались,
/// коли людина міняє номер або оператор перепродає старий.
model PhoneHistory {
  id       Int       @id @default(autoincrement())
  personId Int
  person   Person    @relation(fields: [personId], references: [id])
  phone    String
  from     DateTime
  to       DateTime?

  @@index([personId])
}

/// Факт роботи: людина на штатній одиниці. Статус — наслідок процесу
/// (онбординг/звільнення), вручну не змінюється.
model Employment {
  id           Int              @id @default(autoincrement())
  personId     Int
  person       Person           @relation(fields: [personId], references: [id])
  staffUnitId  Int
  staffUnit    StaffUnit        @relation(fields: [staffUnitId], references: [id])
  status       EmploymentStatus @default(REGISTERED)
  hiredAt      DateTime?
  terminatedAt DateTime?
  rate         Decimal?         @db.Decimal(3, 2)

  /// Заморозка (docs v1.2 §3) — заповнюються лише коли status = FROZEN.
  frozenReasonCode      String?
  frozenReason          FreezeReason? @relation(fields: [frozenReasonCode], references: [code])
  frozenSince           DateTime?
  plannedReturnAt       DateTime?
  /// true = позиція звільняється на час заморозки (можна брати заміну).
  freezeVacatesPosition Boolean?

  /// Звільнення (docs plan-v1.md §12, catalogs-v1.1.md §8) — заповнюються
  /// при ініціації, тільки коли status = TERMINATION_STARTED/TERMINATED.
  terminationReasonCode String?
  terminationReason     TerminationReason? @relation(fields: [terminationReasonCode], references: [code])
  lastWorkingDay        DateTime?

  managerId                  Int?
  manager                    Employment?          @relation("EmploymentManager", fields: [managerId], references: [id])
  subordinates               Employment[]         @relation("EmploymentManager")
  areaResponsibilities       AreaResponsible[]    @relation("AreaResponsibleEmployment")
  regulationVersionsCreated  RegulationVersion[]  @relation("RegulationVersionCreatedBy")
  inspectionSchedulesUpdated InspectionSchedule[] @relation("InspectionScheduleUpdatedBy")
  inspectionsConducted       Inspection[]         @relation("InspectionConductedBy")
  inspectionResults          InspectionResult[]   @relation("InspectionResultSubject")

  /// Куратор — призначається пунктом чек-ліста онбордингу "Призначення
  /// куратора" (docs hr-system-plan-v1.md §8, п.2). Раніше було null-заглушкою
  /// в резолвінгу задач CURATOR-ролі — тепер реальне поле.
  curatorId Int?
  curator   Employment?  @relation("EmploymentCurator", fields: [curatorId], references: [id])
  curatees  Employment[] @relation("EmploymentCurator")

  headOfNodes     OrgNode[]
  roleAssignments RoleAssignment[]

  processInstances            ProcessInstance[]
  assignedTasks               Task[]               @relation("TaskAssignee")
  completedTasks              Task[]               @relation("TaskCompletedBy")
  authoredRatingEvents        RatingEvent[]        @relation("RatingEventAuthor")
  awardedBadges               BadgeAward[]         @relation("BadgeAwardedBy")
  clearanceSheets             ClearanceSheet[]
  uploadedDocuments           Document[]
  updatedMaterials            Material[]           @relation("MaterialContentUpdatedBy")
  responsibleEquipment        Equipment[]
  equipmentEvents             EquipmentEvent[]     @relation("EquipmentEventEmployment")
  performedEquipmentEvents    EquipmentEvent[]     @relation("EquipmentEventPerformedBy")
  auditActions                AuditLog[]
  attestationAttempts         AttestationAttempt[]
  gradedAttestations          AttestationAttempt[] @relation("AttestationGradedBy")
  reviews                     Review[]
  confirmedReviews            Review[]             @relation("ReviewConfirmedBy")
  createdReviews              Review[]             @relation("ReviewCreatedBy")
  vacationRequests            VacationRequest[]
  createdVacationRequests     VacationRequest[]    @relation("VacationCreatedBy")
  decidedVacationRequests     VacationRequest[]    @relation("VacationDecidedBy")
  remindersAbout              Reminder[]           @relation("ReminderAboutEmployment")
  authoredReminders           Reminder[]           @relation("ReminderAuthor")
  curatorEligibilities        CuratorEligibility[] @relation("CuratorEligibilities")
  grantedCuratorEligibilities CuratorEligibility[] @relation("CuratorEligibilityGrantedBy")
  createdVacancies            Vacancy[]            @relation("VacancyCreatedBy")
  registeredTerminals         Terminal[]           @relation("TerminalRegisteredBy")
  workShiftsOf                WorkShift[]          @relation("WorkShiftEmployment")
  editedShifts                WorkShift[]          @relation("WorkShiftEditedBy")
  scanEventsAsEmployee        ScanEvent[]          @relation("ScanEventEmployment")
  scanEventsAsOperator        ScanEvent[]          @relation("ScanEventOperator")
  closedVacancies             Vacancy[]            @relation("VacancyClosedBy")
  authoredAnnouncements       Announcement[]       @relation("AnnouncementAuthor")
  authoredPolls               Poll[]               @relation("PollAuthor")

  @@index([personId])
  @@index([staffUnitId])
}

/// Особисті нагадування (правки 20.09.2026, п.7) — не пункт чек-ліста
/// (Task), а вільна нотатка автора про конкретного працівника; видима
/// лише самому автору. Гейт MANAGE_REMINDERS — можливість існувала в
/// enum Capability з першої сесії проєкту, коду під неї не було.
model Reminder {
  id           Int        @id @default(autoincrement())
  employmentId Int
  employment   Employment @relation("ReminderAboutEmployment", fields: [employmentId], references: [id])
  authorId     Int
  author       Employment @relation("ReminderAuthor", fields: [authorId], references: [id])
  text         String
  dueAt        DateTime?
  isDone       Boolean    @default(false)
  doneAt       DateTime?
  /// Щоб щогодинна перевірка (bot/index.ts) не дублювала сповіщення —
  /// той самий принцип, що й Task.overdueNotifiedAt.
  notifiedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([authorId])
  @@index([employmentId])
}

/// Глобальний каталог посад — редагується без розробника.
model PositionProfile {
  id                     Int               @id @default(autoincrement())
  title                  String            @unique
  level                  Int
  canBeCurator           Boolean           @default(false)
  requiresCashierAccount Boolean           @default(false)
  isFoodHandling         Boolean           @default(false)
  isMateriallyLiable     Boolean           @default(false)
  systemRole             Role?
  isActive               Boolean           @default(true)
  externalRef            String?
  /// Автопідбір модулів онбордингу за прапорцями посади (docs v1.1 §10).
  moduleFlags            ChecklistModule[] @default([])

  staffUnits             StaffUnit[]
  accessAssignments      PositionAccessAssignment[]
  positionCompetencies   PositionCompetency[]
  reviewCriterionWeights ReviewCriterionWeight[]
  curatorEligibilities   CuratorEligibility[]
  regulationItems        RegulationItem[]
}

/// Кураторство "з людини" (правки 20.09.2026, п.9) — точніший, per-людина
/// шар над PositionProfile.canBeCurator (той лишається загальною ознакою
/// посади). Адміністратор вручну обирає, для яких посад САМЕ ЦЯ людина
/// може бути куратором; grant перевіряє її чинні компетенції відносно
/// вимог цільової посади (lib/curator.ts::grantCuratorEligibility).
model CuratorEligibility {
  id                Int             @id @default(autoincrement())
  employmentId      Int
  employment        Employment      @relation("CuratorEligibilities", fields: [employmentId], references: [id])
  positionProfileId Int
  positionProfile   PositionProfile @relation(fields: [positionProfileId], references: [id])
  grantedById       Int
  grantedBy         Employment      @relation("CuratorEligibilityGrantedBy", fields: [grantedById], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([employmentId, positionProfileId])
}

/// Штатна одиниця — посада, розставлена в конкретний вузол дерева.
model StaffUnit {
  id                Int             @id @default(autoincrement())
  positionProfileId Int
  positionProfile   PositionProfile @relation(fields: [positionProfileId], references: [id])
  orgNodeId         Int
  orgNode           OrgNode         @relation(fields: [orgNodeId], references: [id])
  plannedHeadcount  Int             @default(1)

  employments Employment[]
  vacancies   Vacancy[]

  @@unique([positionProfileId, orgNodeId])
}

enum VacancyReason {
  TERMINATION
  NEW_POSITION
  HEADCOUNT_INCREASE
}

enum VacancyStatus {
  OPEN
  POSTED
  CLOSED
}

/// Задача "закрити вакансію" (з розмови 2026-09-23, поза докс) — проста
/// задача-нагадування, НЕ картка кандидатів. Автоматично при звільненні
/// й новій посаді (lib/termination.ts::startTermination,
/// app/api/staff-units/route.ts::POST); вручну — при зростанні плану чи
/// будь-коли адміністратором. Гейт MANAGE_VACANCIES, OWN_OBJECT для
/// адміністратора магазину / OWN_SUBTREE для кластерного керівника —
/// та сама область автоматично дає кластерному керівнику "зведення" по
/// всьому кластеру, без окремого механізму.
model Vacancy {
  id          Int           @id @default(autoincrement())
  staffUnitId Int
  staffUnit   StaffUnit     @relation(fields: [staffUnitId], references: [id])
  reason      VacancyReason
  status      VacancyStatus @default(OPEN)
  note        String?
  createdById Int?
  createdBy   Employment?   @relation("VacancyCreatedBy", fields: [createdById], references: [id])
  closedById  Int?
  closedBy    Employment?   @relation("VacancyClosedBy", fields: [closedById], references: [id])
  createdAt   DateTime      @default(now())
  postedAt    DateTime?
  closedAt    DateTime?

  @@index([staffUnitId])
}

/// Оголошення (з розмови 2026-09-24, поза докс) — керівник обирає вузол
/// дерева (відділ/магазин/кластер/компанія) у межах своєї дозволеної
/// області, повідомлення йде всім активним працівникам у цьому вузлі й
/// нижче. Гейт MANAGE_ANNOUNCEMENTS, та сама модель області, що й Vacancy.
model Announcement {
  id        Int         @id @default(autoincrement())
  orgNodeId Int
  orgNode   OrgNode     @relation(fields: [orgNodeId], references: [id])
  title     String
  body      String
  authorId  Int?
  author    Employment? @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([orgNodeId])
}

enum PollStatus {
  OPEN
  CLOSED
}

/// Опитування (з розмови 2026-09-24, поза докс) — та сама модель області,
/// що Announcement. isAnonymous керує лише тим, що видно в результатах
/// (lib/polls.ts) — сам голос (PollVote.personId) завжди зберігається, щоб
/// не дати проголосувати двічі; при анонімному опитуванні автор бачить
/// тільки підсумкові цифри, не хто саме як проголосував.
model Poll {
  id          Int         @id @default(autoincrement())
  orgNodeId   Int
  orgNode     OrgNode     @relation(fields: [orgNodeId], references: [id])
  question    String
  isAnonymous Boolean     @default(false)
  status      PollStatus  @default(OPEN)
  authorId    Int?
  author      Employment? @relation("PollAuthor", fields: [authorId], references: [id])
  createdAt   DateTime    @default(now())
  closesAt    DateTime?
  closedAt    DateTime?

  options PollOption[]
  votes   PollVote[]

  @@index([orgNodeId])
}

model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       Int        @id @default(autoincrement())
  pollId   Int
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId Int
  option   PollOption @relation(fields: [optionId], references: [id])
  personId Int
  person   Person     @relation(fields: [personId], references: [id])
  votedAt  DateTime   @default(now())

  @@unique([pollId, personId])
  @@index([optionId])
}

/// Профіль доступу — пойменований набір можливостей (capability) БЕЗ
/// області дії. Адмініструється окремо від того, кому його призначено —
/// "Повне управління об'єктом" можна дати і адміністратору магазину, і
/// директору кластера, кожному зі своєю областю (PositionAccessAssignment).
model AccessProfile {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  capabilities AccessProfileCapability[]
  assignments  PositionAccessAssignment[]
}

model AccessProfileCapability {
  id              Int           @id @default(autoincrement())
  accessProfileId Int
  accessProfile   AccessProfile @relation(fields: [accessProfileId], references: [id])
  capability      Capability

  @@unique([accessProfileId, capability])
}

/// Призначення профілю доступу посаді або функціональній ролі — тут і
/// тільки тут задається область дії (scope). Одна посада може мати кілька
/// призначень (базовий профіль + додатковий, кожен зі своєю областю).
model PositionAccessAssignment {
  id                Int              @id @default(autoincrement())
  positionProfileId Int?
  positionProfile   PositionProfile? @relation(fields: [positionProfileId], references: [id])
  role              Role?
  accessProfileId   Int
  accessProfile     AccessProfile    @relation(fields: [accessProfileId], references: [id])
  scope             ScopeType
  customNodeId      Int?
  customNode        OrgNode?         @relation(fields: [customNodeId], references: [id])

  @@index([positionProfileId])
  @@index([role])
}

/// Функціональна роль (бухгалтер, 1С, ревізор, COO...), що не входить
/// у рівневу ієрархію посад. orgNodeId визначає область: доступ
/// поширюється на все піддерево.
model RoleAssignment {
  id           Int        @id @default(autoincrement())
  employmentId Int
  employment   Employment @relation(fields: [employmentId], references: [id])
  role         Role
  orgNodeId    Int
  orgNode      OrgNode    @relation(fields: [orgNodeId], references: [id])
  createdAt    DateTime   @default(now())
  createdById  Int?

  @@unique([employmentId, role, orgNodeId])
}

/// Довідник компетенцій. Навчання рахується по компетенціях, не по треках:
/// дельта = компетенції_посади − чинні_компетенції_людини (docs v1.2 §1).
model Competency {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  name               String
  /// Довільна категорія для групування в "Довідниках" (2026-09-25) —
  /// не enum: невеликий, вільно редагований список, не частина основної
  /// бізнес-логіки (на відміну від ChecklistModule тощо).
  category           String?
  validMonths        Int?
  resetOnBreakMonths Int?
  isBonus            Boolean @default(false)

  positionCompetencies   PositionCompetency[]
  records                CompetencyRecord[]
  materials              Material[]
  checklistItemTemplates ChecklistItemTemplate[]
  attestationScores      AttestationCompetencyScore[]
}

/// Що вимагає профіль посади. isRequired розрізняє обов'язкову й
/// рекомендовану компетенцію (тема "посада — компетенції — атестація",
/// 2026-09-25) — обов'язкові блокують допуск до роботи при атестації,
/// рекомендовані лише оцінюються, без блокування.
model PositionCompetency {
  positionProfileId Int
  positionProfile   PositionProfile @relation(fields: [positionProfileId], references: [id])
  competencyId      Int
  competency        Competency      @relation(fields: [competencyId], references: [id])
  isRequired        Boolean         @default(true)

  @@id([positionProfileId, competencyId])
}

/// Що людина фактично має. Під час заморозки годинник строку дії
/// зупиняється: frozenDays накопичується й додається до validUntil
/// при розморозці (docs v1.2 §3).
model CompetencyRecord {
  id           Int              @id @default(autoincrement())
  personId     Int
  person       Person           @relation(fields: [personId], references: [id])
  competencyId Int
  competency   Competency       @relation(fields: [competencyId], references: [id])
  passedAt     DateTime
  score        Int?
  validUntil   DateTime?
  source       CompetencySource
  frozenDays   Int              @default(0)

  @@index([personId])
  @@index([competencyId])
}

/// Навчальний матеріал. Належить компетенції (docs v1.2 §7: "компетенція
/// має матеріали й тест") — навчальний профіль посади збирається
/// автоматично через PositionCompetency, окремої прив'язки матеріал↔посада
/// не потрібно. Відео — тільки через intranet, PDF можна й через бот
/// (docs hr-system-plan-v1.md §9.1).
model Material {
  id                 Int          @id @default(autoincrement())
  competencyId       Int
  competency         Competency   @relation(fields: [competencyId], references: [id])
  title              String
  type               MaterialType
  url                String?
  filePath           String?
  /// Ім'я й MIME-тип завантаженого файлу (для видачі — Content-Disposition/
  /// Content-Type) — заповнюються лише для filePath-матеріалів, не для url.
  originalName       String?
  mimeType           String?
  durationMin        Int?
  sendViaBot         Boolean      @default(false)
  /// Легкий журнал версій (2026-09-27) — не зберігає самі старі файли
  /// (замінюються фізично, lib/materials.ts::replaceMaterialFile), лише
  /// коли й ким востаннє замінено вміст; null = від створення не замінювали.
  /// Повна історія замін — AuditLog(entityType="Material", action="material.contentReplaced").
  contentUpdatedAt   DateTime?
  contentUpdatedById Int?
  contentUpdatedBy   Employment?  @relation("MaterialContentUpdatedBy", fields: [contentUpdatedById], references: [id])

  @@index([competencyId])
}

/// Онбординг/звільнення не програмуються — це конфігуровані шаблони.
/// Версіонується: редагування створює нову версію, активні процеси
/// доживають на старій (docs hr-system-catalogs-v1.1.md §9).
model ProcessTemplate {
  id       Int         @id @default(autoincrement())
  code     String
  version  Int
  type     ProcessType
  name     String
  isActive Boolean     @default(true)

  items     ChecklistItemTemplate[]
  instances ProcessInstance[]

  @@unique([code, version])
}

/// Пункт чек-ліста шаблону. module = null означає базовий пункт
/// (виконується для всіх); інакше — надбудова, що підключається лише
/// якщо вона є в PositionProfile.moduleFlags (docs v1.1 §6.1-6.2).
model ChecklistItemTemplate {
  id              Int              @id @default(autoincrement())
  templateId      Int
  template        ProcessTemplate  @relation(fields: [templateId], references: [id])
  order           Int
  title           String
  /// null = виконує сама система (AUTO-пункт), без резолвінгу виконавця.
  responsibleRole Role?
  actionType      ActionType
  isBlocking      Boolean          @default(true)
  slaHours        Int?
  module          ChecklistModule?
  /// Прив'язка для actionType=TEST — яку компетенцію підтверджує складання.
  competencyId    Int?
  competency      Competency?      @relation(fields: [competencyId], references: [id])

  tasks Task[]

  @@index([templateId])
}

/// Атестація більше не конструюється вручну (текстові розділи/пункти) —
/// таблиця збирається автоматично зі списку PositionCompetency посади,
/// один рядок на компетенцію (тема "посада — компетенції — атестація",
/// 2026-09-25, замінює старий AttestationTemplate/Section/Item). Бал 0/1/2
/// на кожну; 1 і 2 — компетенція зарахована, 0 — ні. Допуск до роботи —
/// коли зараховані ВСІ обов'язкові (isRequired=true) компетенції посади,
/// рекомендовані оцінюються, але не блокують. Позиція без жодної
/// PositionCompetency — атестації немає, проста кнопка (як і раніше).
model AttestationAttempt {
  id            Int        @id @default(autoincrement())
  employmentId  Int
  employment    Employment @relation(fields: [employmentId], references: [id])
  attemptNumber Int
  passed        Boolean
  gradedById    Int
  gradedBy      Employment @relation("AttestationGradedBy", fields: [gradedById], references: [id])
  occurredAt    DateTime   @default(now())

  competencyScores AttestationCompetencyScore[]

  @@index([employmentId])
}

model AttestationCompetencyScore {
  id           Int                @id @default(autoincrement())
  attemptId    Int
  attempt      AttestationAttempt @relation(fields: [attemptId], references: [id])
  competencyId Int
  competency   Competency         @relation(fields: [competencyId], references: [id])
  /// 0 (не здав) / 1 (треба попрацювати, зараховано) / 2 (молодець).
  score        Int

  @@index([attemptId])
  @@index([competencyId])
}

/// Конкретний запуск шаблону для конкретного працевлаштування.
model ProcessInstance {
  id           Int             @id @default(autoincrement())
  employmentId Int
  employment   Employment      @relation(fields: [employmentId], references: [id])
  templateId   Int
  template     ProcessTemplate @relation(fields: [templateId], references: [id])
  state        ProcessState    @default(RUNNING)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?

  tasks           Task[]
  equipmentEvents EquipmentEvent[]

  @@index([employmentId])
}

/// Конкретна задача з чек-ліста. status зберігає лише PENDING/DONE —
/// "заблоковано" й "протерміновано" рахуються на льоту (див. TaskStatus).
model Task {
  id                Int                   @id @default(autoincrement())
  instanceId        Int
  instance          ProcessInstance       @relation(fields: [instanceId], references: [id])
  itemTemplateId    Int
  itemTemplate      ChecklistItemTemplate @relation(fields: [itemTemplateId], references: [id])
  assigneeId        Int?
  assignee          Employment?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status            TaskStatus            @default(PENDING)
  payload           Json?
  comment           String?
  dueAt             DateTime?
  completedAt       DateTime?
  completedById     Int?
  completedBy       Employment?           @relation("TaskCompletedBy", fields: [completedById], references: [id])
  /// SLA-ескалація (docs plan-v1.md §8, п.11): коли виконавця вже
  /// сповіщено про протермінування й коли ескальовано керівнику вузла —
  /// щоб щогодинна перевірка не дублювала сповіщення.
  overdueNotifiedAt DateTime?
  escalatedAt       DateTime?

  @@index([instanceId])
  @@index([assigneeId])
}

/// Довідник приводів позитив/негатив (docs v1.3 §2.1). Редагується.
model RatingCategory {
  code          String     @id
  name          String
  side          RatingSide
  defaultPoints Int
  isActive      Boolean    @default(true)

  events RatingEvent[]
}

/// Подія рейтингу. ratingScore людини = сума points за останні 12 міс,
/// без скасованих — рахується на льоту (lib/rating.ts), не зберігається.
model RatingEvent {
  id           Int             @id @default(autoincrement())
  personId     Int
  person       Person          @relation(fields: [personId], references: [id])
  type         RatingType
  categoryCode String?
  category     RatingCategory? @relation(fields: [categoryCode], references: [code])
  points       Int
  /// Обов'язковий для NEGATIVE і AWARD (docs v1.3 §2.1, §2.2).
  comment      String?
  visibility   Visibility
  authorId     Int
  author       Employment      @relation("RatingEventAuthor", fields: [authorId], references: [id])
  occurredAt   DateTime        @default(now())
  cancelledAt  DateTime?
  cancelReason String?

  @@index([personId])
  @@index([authorId])
}

/// Каталог бейджів — автоматичні (isAuto) і ручні номінації (docs v1.3 §3).
model Badge {
  code        String  @id
  name        String
  description String
  isAuto      Boolean
  ruleJson    Json?

  awards BadgeAward[]
}

/// Факт нагородження. awardedById = null для автоматичних бейджів.
model BadgeAward {
  id          Int         @id @default(autoincrement())
  personId    Int
  person      Person      @relation(fields: [personId], references: [id])
  badgeCode   String
  badge       Badge       @relation(fields: [badgeCode], references: [code])
  awardedAt   DateTime    @default(now())
  awardedById Int?
  awardedBy   Employment? @relation("BadgeAwardedBy", fields: [awardedById], references: [id])
  comment     String?

  @@index([personId])
}

/// Вага критерію для посади (docs v1.3 §4: "у касира вища вага
/// обслуговування, у пекаря — якості й санітарії"). Відсутній рядок для
/// критерію = вага за замовчуванням (порівну з рештою) — окремого
/// редактора ваг поки нема, налаштовується напряму через API.
model ReviewCriterionWeight {
  id                Int             @id @default(autoincrement())
  positionProfileId Int
  positionProfile   PositionProfile @relation(fields: [positionProfileId], references: [id])
  criterion         ReviewCriterion
  weight            Int

  @@unique([positionProfileId, criterion])
}

/// Квартальна оцінка (docs v1.3 §4). weightedScore — знімок на момент
/// створення (як і AttestationAttempt): подальша зміна ваг критеріїв не
/// переписує вже виставлені оцінки. Не публікується працівнику, доки
/// conversationConfirmedAt не проставлений — саме це поле є "воротами"
/// видимості (docs: "результат не публікується, доки керівник не
/// зафіксував, що бесіда відбулася"). employeeAcknowledgedAt — окреме
/// підтвердження ознайомлення через кнопку в Telegram, для звітності.
model Review {
  id            Int        @id @default(autoincrement())
  employmentId  Int
  employment    Employment @relation(fields: [employmentId], references: [id])
  year          Int
  quarter       Int
  weightedScore Float

  conversationConfirmedAt   DateTime?
  conversationConfirmedById Int?
  conversationConfirmedBy   Employment? @relation("ReviewConfirmedBy", fields: [conversationConfirmedById], references: [id])
  employeeAcknowledgedAt    DateTime?

  createdById Int
  createdBy   Employment @relation("ReviewCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  scores ReviewScore[]

  @@unique([employmentId, year, quarter])
  @@index([employmentId])
}

model ReviewScore {
  id        Int             @id @default(autoincrement())
  reviewId  Int
  review    Review          @relation(fields: [reviewId], references: [id])
  criterion ReviewCriterion
  score     Int
  weight    Int

  @@unique([reviewId, criterion])
}

enum VacationType {
  ANNUAL
  UNPAID
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Заявка на відпустку (docs v1.2 §4). Погодження — не через рушій
/// чек-лістів (як онбординг/переведення/звільнення), а пряме рішення
/// погоджувача, як і RatingEvent — тут нема покрокового процесу, лише
/// заявка → перевірка конфліктів → рішення.
model VacationRequest {
  id           Int            @id @default(autoincrement())
  employmentId Int
  employment   Employment     @relation(fields: [employmentId], references: [id])
  type         VacationType
  fromDate     DateTime
  toDate       DateTime
  status       VacationStatus @default(PENDING)

  /// Заявлено менше ніж за 14 днів до початку (docs §4.2).
  isOutOfSchedule    Boolean @default(false)
  /// Одночасно відсутні >30% штатних одиниць цієї посади у цьому вузлі —
  /// або (isCriticalPosition) працівник єдиний на посаді у вузлі.
  hasConflict        Boolean @default(false)
  isCriticalPosition Boolean @default(false)
  conflictNote       String?
  /// true, якщо isOutOfSchedule АБО hasConflict (без критичної) — рішення
  /// вимагає ширшої області, ніж прямий керівник об'єкта (docs: "рівнем вище").
  requiresEscalation Boolean @default(false)

  createdById  Int
  createdBy    Employment  @relation("VacationCreatedBy", fields: [createdById], references: [id])
  decidedById  Int?
  decidedBy    Employment? @relation("VacationDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([employmentId])
}

/// Довідник причин заморозки (docs v1.2 §3) — редагується.
model FreezeReason {
  code     String  @id
  name     String
  isActive Boolean @default(true)

  employments Employment[]
}

/// Довідник причин звільнення (docs v1.1 §10: "зараз текст, потім
/// мапиться на статті КЗпП") — редагується.
model TerminationReason {
  code     String  @id
  name     String
  isActive Boolean @default(true)

  employments Employment[]
}

/// Лист узгодження звільнення (docs plan-v1.md §12.2). pdfPath поки
/// завжди null — Puppeteer не піднятий, генеруємо лише дані й хеш стану,
/// не файл.
model ClearanceSheet {
  id            Int        @id @default(autoincrement())
  number        String     @unique
  employmentId  Int
  employment    Employment @relation(fields: [employmentId], references: [id])
  instanceId    Int
  generatedById Int
  generatedAt   DateTime   @default(now())
  isComplete    Boolean
  pdfPath       String?
  hash          String

  @@index([employmentId])
}

/// Довідник типів документів (docs catalogs-v1.1.md §5.1) — редагується.
/// hasExpiry/reminderDaysBefore — для майбутніх нагадувань (канал:
/// Telegram-бот, коли буде); retentionMonths — строк зберігання скану
/// після звільнення (docs plan-v1.md §14).
model DocumentType {
  code               String  @id
  name               String
  hasExpiry          Boolean @default(false)
  reminderDaysBefore Int?
  retentionMonths    Int?
  isActive           Boolean @default(true)

  documents Document[]
}

/// Скан документа. Файл — тільки на локальному диску поза `public/`
/// (docs: "скани документів завантажуються тільки через веб, ніколи
/// через бот"), у базі — лише шлях. Дата спливання — не формула, а те,
/// що надруковано на самому документі, тому вводиться вручну при
/// завантаженні (на відміну від CompetencyRecord.validUntil).
model Document {
  id               Int          @id @default(autoincrement())
  personId         Int
  person           Person       @relation(fields: [personId], references: [id])
  documentTypeCode String
  documentType     DocumentType @relation(fields: [documentTypeCode], references: [code])
  filePath         String
  originalName     String
  mimeType         String
  uploadedById     Int
  uploadedBy       Employment   @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime     @default(now())
  expiresAt        DateTime?

  @@index([personId])
}

/// Журнал дій (docs plan-v1.md §4.3/§14). Перша ітерація покриває тільки
/// зміни, для яких уже є API — переведення, заморозка, звільнення,
/// куратор. Права й оргструктура поки без власного API редагування
/// (тільки seed), тому логувати їхні зміни нема звідки — окремий крок,
/// коли з'явиться UI редагування.
model AuditLog {
  id         Int         @id @default(autoincrement())
  actorId    Int?
  actor      Employment? @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   Int?
  diff       Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

/// Текст сповіщень (docs plan-v1.md §8: "Шаблони повідомлень — у БД, не в
/// коді") — редагує SYSADMIN через /catalog без розробника. `key` —
/// стабільний ідентифікатор із коду (напр. "vacation.approved"),
/// `{{плейсхолдери}}` підставляються при відправці.
model NotificationTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  description String
  text        String
  updatedAt   DateTime @updatedAt
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/// Журнал кожного фактичного відправлення (docs plan-v1.md §8: "Кожне
/// відправлення пишеться в Notification зі статусом, ретраї через
/// pg-boss"). `text` — уже відрендерений текст на момент відправки (не
/// посилання на шаблон), щоб історія не "переписувалась", коли хтось
/// згодом відредагує шаблон. `status` — поточний відомий стан: FAILED тут
/// означає "останній зареєстрований збій", а не "вичерпано всі ретраї" —
/// pg-boss може ще повторити спробу, і статус тоді перепишеться на SENT.
model Notification {
  id          Int                @id @default(autoincrement())
  recipientId Int
  recipient   Person             @relation(fields: [recipientId], references: [id])
  templateKey String?
  text        String
  status      NotificationStatus @default(QUEUED)
  error       String?
  createdAt   DateTime           @default(now())
  sentAt      DateTime?

  @@index([recipientId])
}

/// Обладнання, закріплене за працівником (docs plan-v1.md §11).
model Equipment {
  id            Int         @id @default(autoincrement())
  inventoryNo   String      @unique
  name          String
  orgNodeId     Int
  orgNode       OrgNode     @relation(fields: [orgNodeId], references: [id])
  responsibleId Int?
  responsible   Employment? @relation(fields: [responsibleId], references: [id])
  assignedAt    DateTime?
  isActive      Boolean     @default(true)

  events EquipmentEvent[]

  @@index([orgNodeId])
  @@index([responsibleId])
}

enum EquipmentEventType {
  ASSIGNED
  CLEARED
}

/// Історія квитувань обладнання — окремо від Equipment.responsibleId
/// (поточного стану), бо лист узгодження при звільненні мусить показати,
/// що саме й ким було квитовано під час цього процесу, навіть якщо на
/// момент друку обладнання вже давно передане іншому.
model EquipmentEvent {
  id                Int                @id @default(autoincrement())
  equipmentId       Int
  equipment         Equipment          @relation(fields: [equipmentId], references: [id])
  type              EquipmentEventType
  /// Працевлаштування, за яким обладнання було закріплене/з якого зняте.
  employmentId      Int
  employment        Employment         @relation("EquipmentEventEmployment", fields: [employmentId], references: [id])
  performedById     Int
  performedBy       Employment         @relation("EquipmentEventPerformedBy", fields: [performedById], references: [id])
  /// Процес (переведення/звільнення), у межах якого сталася подія — null для звичайного закріплення/зняття поза процесом.
  processInstanceId Int?
  processInstance   ProcessInstance?   @relation(fields: [processInstanceId], references: [id])
  occurredAt        DateTime           @default(now())

  @@index([equipmentId])
  @@index([employmentId])
  @@index([processInstanceId])
}

/// Комп'ютер-термінал обліку робочого часу (2026-10-18). Токен лежить у
/// httpOnly-cookie комп'ютера, у базі — лише хеш; магазин береться з
/// терміналу, а не з вибору касира. revokedAt — відкликаний сисадміном.
/// lastSeenAt оновлюється кожним запитом терміналу (контроль "мовчання",
/// етап 4).
model Terminal {
  id               Int        @id @default(autoincrement())
  orgNodeId        Int
  orgNode          OrgNode    @relation(fields: [orgNodeId], references: [id])
  name             String
  tokenHash        String     @unique
  registeredById   Int
  registeredBy     Employment @relation("TerminalRegisteredBy", fields: [registeredById], references: [id])
  createdAt        DateTime   @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  /// Скільки відміток чекає відправки на самому комп'ютері (офлайн-черга) — з останнього сигналу.
  lastPendingCount Int        @default(0)
  /// Коли надіслано алерт "термінал мовчить"; скидається, щойно термінал озвався.
  silenceAlertedAt DateTime?

  scanEvents  ScanEvent[]
  startShifts WorkShift[] @relation("WorkShiftStartTerminal")
  endShifts   WorkShift[] @relation("WorkShiftEndTerminal")

  @@index([orgNodeId])
}

enum ScanAction {
  ARRIVAL
  DEPARTURE
}

enum ShiftCloseKind {
  TERMINAL
  MANUAL
  AUTO
}

/// Робоча зміна: від прибуття до завершення. orgNodeId — магазин, де
/// зміну розпочато. endedAt = null — зміна відкрита.
model WorkShift {
  id              Int             @id @default(autoincrement())
  employmentId    Int
  employment      Employment      @relation("WorkShiftEmployment", fields: [employmentId], references: [id])
  orgNodeId       Int
  orgNode         OrgNode         @relation(fields: [orgNodeId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  startTerminalId Int?
  startTerminal   Terminal?       @relation("WorkShiftStartTerminal", fields: [startTerminalId], references: [id])
  endTerminalId   Int?
  endTerminal     Terminal?       @relation("WorkShiftEndTerminal", fields: [endTerminalId], references: [id])
  closeKind       ShiftCloseKind?
  /// Остання ручна правка (повна історія — AuditLog, дія shift.edited/shift.created).
  editedAt        DateTime?
  editedById      Int?
  editedBy        Employment?     @relation("WorkShiftEditedBy", fields: [editedById], references: [id])
  editReason      String?

  scanEvents ScanEvent[]

  @@index([employmentId, endedAt])
  @@index([orgNodeId, startedAt])
}

/// Підтверджене касиром сканування. clientEventId (UUID від терміналу) —
/// ключ ідемпотентності: повторна відправка тієї ж події (подвійний клік,
/// офлайн-черга на етапі 4) не створює другого запису. scannedAt — коли
/// відскановано, receivedAt — коли дійшло до сервера.
model ScanEvent {
  id            Int        @id @default(autoincrement())
  clientEventId String     @unique
  employmentId  Int
  employment    Employment @relation("ScanEventEmployment", fields: [employmentId], references: [id])
  terminalId    Int
  terminal      Terminal   @relation(fields: [terminalId], references: [id])
  operatorId    Int
  operator      Employment @relation("ScanEventOperator", fields: [operatorId], references: [id])
  action        ScanAction
  scannedAt     DateTime
  receivedAt    DateTime   @default(now())
  shiftId       Int
  shift         WorkShift  @relation(fields: [shiftId], references: [id])

  @@index([employmentId, scannedAt])
}

/// Тип ділянки (довідник мережі): Гастроном, Молочка, Каси, Вхідна група...
model AreaType {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  /// Ділянка, де протягом зміни має бути персонал (прилавок, каса) — для алерту "ділянка без персоналу".
  requiresStaff Boolean  @default(false)
  /// Загальна ділянка без закріплених працівників (вхідна група, освітлення): порушення по ній іде директору кластера й COO.
  isGeneral     Boolean  @default(false)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  areas           Area[]
  regulationItems RegulationItem[]
}

/// Ділянка конкретного магазину/цеху/складу — не вузол оргдерева.
model Area {
  id         Int      @id @default(autoincrement())
  orgNodeId  Int
  orgNode    OrgNode  @relation(fields: [orgNodeId], references: [id])
  areaTypeId Int
  areaType   AreaType @relation(fields: [areaTypeId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  responsibles      AreaResponsible[]
  inspectionResults InspectionResult[]

  @@unique([orgNodeId, areaTypeId])
}

/// Відповідальний за ділянку; один працівник може відповідати за кілька ділянок.
model AreaResponsible {
  id           Int        @id @default(autoincrement())
  areaId       Int
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  employmentId Int
  employment   Employment @relation("AreaResponsibleEmployment", fields: [employmentId], references: [id])
  assignedAt   DateTime   @default(now())

  @@unique([areaId, employmentId])
}

enum RegulationTarget {
  /// Загальний стан магазину (вхідна група, освітлення, торговий зал)
  GENERAL
  /// Ділянка певного типу — оцінюється кожна такого типу ділянка магазину
  AREA
  /// Індивідуально кожен працівник певної посади (вигляд, тон спілкування)
  PERSON
}

enum InspectionKind {
  DAILY
  WEEKLY
}

enum InspectionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Версія регламенту обходів. Регламент один на мережу; редагування створює
/// нову версію, обхід прив'язується до версії в момент початку й не ламається.
model RegulationVersion {
  id          Int         @id @default(autoincrement())
  version     Int         @unique
  isCurrent   Boolean     @default(false)
  note        String?
  createdById Int?
  createdBy   Employment? @relation("RegulationVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  items       RegulationItem[]
  inspections Inspection[]
}

/// Вимога регламенту. У щоденний обхід потрапляють лише вимоги з inDaily
/// (критичні); щотижневий — детальний, включає всі вимоги.
model RegulationItem {
  id                Int                @id @default(autoincrement())
  versionId         Int
  version           RegulationVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sortOrder         Int
  text              String
  target            RegulationTarget
  areaTypeId        Int?
  areaType          AreaType?          @relation(fields: [areaTypeId], references: [id])
  positionProfileId Int?
  positionProfile   PositionProfile?   @relation(fields: [positionProfileId], references: [id])
  inDaily           Boolean            @default(false)
  results           InspectionResult[]

  @@index([versionId])
}

/// Розклад обходів магазину: щоденний о dailyTime, щотижневий у weeklyDay (1=пн…7=нд) о weeklyTime.
model InspectionSchedule {
  id          Int         @id @default(autoincrement())
  orgNodeId   Int         @unique
  orgNode     OrgNode     @relation(fields: [orgNodeId], references: [id])
  dailyTime   String?
  weeklyDay   Int?
  weeklyTime  String?
  updatedAt   DateTime    @updatedAt
  updatedById Int?
  updatedBy   Employment? @relation("InspectionScheduleUpdatedBy", fields: [updatedById], references: [id])
}

/// Конкретний обхід. Пропущений (день минув, а обхід не почато) переноситься
/// на наступний день той самий час із повідомленням керівникам.
model Inspection {
  id                  Int                @id @default(autoincrement())
  orgNodeId           Int
  orgNode             OrgNode            @relation(fields: [orgNodeId], references: [id])
  kind                InspectionKind
  plannedFor          DateTime
  originalPlannedFor  DateTime
  postponedCount      Int                @default(0)
  status              InspectionStatus   @default(PLANNED)
  regulationVersionId Int?
  regulationVersion   RegulationVersion? @relation(fields: [regulationVersionId], references: [id])
  conductedById       Int?
  conductedBy         Employment?        @relation("InspectionConductedBy", fields: [conductedById], references: [id])
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  results             InspectionResult[]

  @@index([orgNodeId, status])
}

enum InspectionRating {
  GREEN
  YELLOW
  RED
}

/// Оцінка однієї вимоги в обході: для загальної — без суб'єкта, для ділянки — areaId, для працівника — employmentId.
model InspectionResult {
  id           Int              @id @default(autoincrement())
  inspectionId Int
  inspection   Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  itemId       Int
  item         RegulationItem   @relation(fields: [itemId], references: [id])
  areaId       Int?
  area         Area?            @relation(fields: [areaId], references: [id])
  employmentId Int?
  employment   Employment?      @relation("InspectionResultSubject", fields: [employmentId], references: [id])
  rating       InspectionRating
  /// Обов'язковий для RED.
  comment      String?
  /// Шлях відносно storage/ (фото за потреби).
  photoPath    String?
  ratedAt      DateTime         @default(now())

  @@index([inspectionId])
}
