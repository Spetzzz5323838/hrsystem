DATABASE_URL="postgresql://hruser:CHANGE_ME@localhost:5432/hrsystem?schema=public"
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_BOT_USERNAME="CHANGE_ME"

# Бойовий сервер у локальній мережі працює по http, тож cookie без прапорця Secure.
# Якщо поставите https — приберіть цей рядок або змініть на true.
# COOKIE_SECURE="false"

# Лише для першого наповнення бази на бойовому сервері (див. docs/deployment.md):
# SEED_MODE="production"
# INITIAL_ADMIN_PHONE="+380XXXXXXXXX"
# INITIAL_ADMIN_NAME="Прізвище Ім'я По батькові"
# INITIAL_ADMIN_PASSWORD="не коротше 10 символів"

# Більше не використовується (пароль до каси скасовано, замість нього код бейджа).
# ONEC_PASSWORD_KEY="CHANGE_ME"
