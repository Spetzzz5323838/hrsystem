<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8" />
<style>
  @page { size: 86mm 54mm; margin: 0; }
  * { box-sizing: border-box; }
  body {
    font-family: "DejaVu Sans", Arial, sans-serif;
    width: 86mm;
    height: 54mm;
    margin: 0;
    padding: 4mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1.5mm solid #0f172a;
  }
  .company { font-size: 8px; letter-spacing: 0.5px; text-transform: uppercase; color: #475569; }
  .info { text-align: center; }
  .name { font-size: 15px; font-weight: bold; color: #0f172a; }
  .position { margin-top: 1.5mm; font-size: 11px; color: #334155; }
  .object { margin-top: 1mm; font-size: 9px; color: #64748b; }
  .barcode-box {
    width: 100%;
    height: 14mm;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .barcode-box img { height: 100%; max-width: 100%; object-fit: contain; }
  .barcode-placeholder { font-size: 8px; color: #94a3b8; }
</style>
</head>
<body>
  <div class="company">Коровай</div>
  <div class="info">
    <div class="name">{{fullName}}</div>
    <div class="position">{{positionTitle}}</div>
    <div class="object">{{objectName}}</div>
  </div>
  <div class="barcode-box">
    {{#if barcodeDataUri}}
      <img src="{{barcodeDataUri}}" alt="" />
    {{else}}
      <div class="barcode-placeholder">код 1С ще не видано</div>
    {{/if}}
  </div>
</body>
</html>
